# Produccion - plantilla (no usar en produccion sin ajustar)

POSTGRES_DB=piedrazul_prod
POSTGRES_USER=piedrazul_user
POSTGRES_PASSWORD=change_me

# Keycloak (DB y admin)
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak_db
KC_DB_USERNAME=piedrazul_user
KC_DB_PASSWORD=change_me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me

# Keycloak public hostname (expuesto por Nginx)
KEYCLOAK_HOSTNAME=auth.example.com
KEYCLOAK_HOSTNAME_PORT=443
KEYCLOAK_HOSTNAME_STRICT=true
KEYCLOAK_HOSTNAME_STRICT_HTTPS=true
KEYCLOAK_PROXY=edge
KEYCLOAK_PROXY_HEADERS=xforwarded
KC_HTTP_ENABLED=true
KC_HEALTH_ENABLED=true

# Backend
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/piedrazul_prod
SPRING_DATASOURCE_USERNAME=piedrazul_user
SPRING_DATASOURCE_PASSWORD=change_me
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://auth.example.com/realms/piedrazul

# CORS (frontend publico)
APP_CORS_ALLOWED_ORIGINS=https://piedrazul.com,https://www.piedrazul.com
APP_CORS_ALLOW_CREDENTIALS=true

# Keycloak client (consumido por el backend)
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_REALM=piedrazul
KEYCLOAK_CLIENT_ID=piedrazul-backend
KEYCLOAK_CLIENT_SECRET=change_me

# Nginx
NGINX_API_HOST=api.example.com
NGINX_AUTH_HOST=auth.example.com
NGINX_CERTS_DIR=/etc/letsencrypt/live/api.example.com

# Opcional: version de imagen si no haces build en la VM
# BACKEND_IMAGE_TAG=latest
