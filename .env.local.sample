# Local development variables (outside Docker)
# Copy this file to `.env.local` and edit values when running the Spring app locally.
# NOTE: This uses nip.io for DNS resolution, same as docker-compose.dev,
# for consistency between local and containerized environments.

SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/piedrazul_dev?currentSchema=public
SPRING_DATASOURCE_USERNAME=piedrazul_user
SPRING_DATASOURCE_PASSWORD=piedrazul_pass

# For local app outside Docker:
# nip.io automatically resolves auth.127.0.0.1.nip.io → 127.0.0.1
# This works without editing /etc/hosts
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://auth.127.0.0.1.nip.io:8180/realms/piedrazul
KEYCLOAK_SERVER_URL=http://auth.127.0.0.1.nip.io:8180

KEYCLOAK_REALM=piedrazul
KEYCLOAK_CLIENT_ID=piedrazul-backend
KEYCLOAK_CLIENT_SECRET=X7Ef99AJnumJQlqArO919NCTT4O63RaP
