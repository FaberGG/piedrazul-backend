# Local development variables (outside Docker)
# Copy this file to `.env.local` and edit values when running the Spring app locally.
# Keep `SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI` aligned with the
# Keycloak hostname you actually open in the browser.

SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/piedrazul_dev?currentSchema=public
SPRING_DATASOURCE_USERNAME=piedrazul_user
SPRING_DATASOURCE_PASSWORD=piedrazul_pass
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://localhost:8180/realms/piedrazul

KEYCLOAK_SERVER_URL=http://localhost:8180
KEYCLOAK_REALM=piedrazul
KEYCLOAK_CLIENT_ID=piedrazul-backend
KEYCLOAK_CLIENT_SECRET=X7Ef99AJnumJQlqArO919NCTT4O63RaP

