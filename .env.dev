# Variables locales de desarrollo
# Docker Compose / PostgreSQL del contenedor
POSTGRES_DB=piedrazul_dev
POSTGRES_USER=piedrazul_user
POSTGRES_PASSWORD=piedrazul_pass

# pgAdmin (contenedor)
PGADMIN_DEFAULT_EMAIL=admin@piedrazul.com
PGADMIN_DEFAULT_PASSWORD=admin

# Keycloak (contenedor Docker)
KC_HOSTNAME=keycloak
KC_HOSTNAME_PORT=8180
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_HEALTH_ENABLED=true
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_SECRET=X7Ef99AJnumJQlqArO919NCTT4O63RaP
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak_db
KC_DB_USERNAME=piedrazul_user
KC_DB_PASSWORD=piedrazul_pass

# NOTE: Local-only Spring/Keycloak variables were moved to `.env.local` so
# the compose stack uses the internal values. If you run the app locally
# outside Docker, copy `.env.local.sample` -> `.env.local` and edit values.

