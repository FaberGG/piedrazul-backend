# Variables locales de desarrollo
# Docker Compose / PostgreSQL del contenedor
POSTGRES_DB=piedrazul_dev
POSTGRES_USER=piedrazul_user
POSTGRES_PASSWORD=piedrazul_pass

# pgAdmin (contenedor)
PGADMIN_DEFAULT_EMAIL=admin@piedrazul.com
PGADMIN_DEFAULT_PASSWORD=admin

# Keycloak (contenedor Docker)
# Usa nip.io para resolver auth.127.0.0.1.nip.io → 127.0.0.1 automáticamente
# Sin necesidad de editar /etc/hosts en Windows/Mac/Linux
KC_HOSTNAME=auth.127.0.0.1.nip.io
KC_HOSTNAME_PORT=8180
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_HEALTH_ENABLED=true
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_SECRET=X7Ef99AJnumJQlqArO919NCTT4O63RaP
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak_db
KC_DB_USERNAME=piedrazul_user
KC_DB_PASSWORD=piedrazul_pass

# Spring Boot - variables para aplicación en contenedor (dentro del stack Docker)
# Nota: en docker-compose.yml también están bajo `environment:` con defaults,
# pero estos valores en `.env.dev` tienen prioridad cuando haces `docker compose --env-file .env.dev`
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/piedrazul_dev
SPRING_DATASOURCE_USERNAME=piedrazul_user
SPRING_DATASOURCE_PASSWORD=piedrazul_pass
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://auth.127.0.0.1.nip.io:8180/realms/piedrazul

# Keycloak client - variables consumidas por la app en el stack Docker
KEYCLOAK_SERVER_URL=http://auth.127.0.0.1.nip.io:8180
KEYCLOAK_REALM=piedrazul
KEYCLOAK_CLIENT_ID=piedrazul-backend
KEYCLOAK_CLIENT_SECRET=X7Ef99AJnumJQlqArO919NCTT4O63RaP

MAIL_USERNAME=piedrazulclinica@gmail.com
MAIL_PASSWORD=thuouoszvbdjwpnl
