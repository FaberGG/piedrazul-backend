# Variables locales de desarrollo
# Docker Compose (PostgreSQL app)
POSTGRES_DB=piedrazul_dev
POSTGRES_USER=piedrazul_user
POSTGRES_PASSWORD=piedrazul_pass

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@piedrazul.com
PGADMIN_DEFAULT_PASSWORD=admin

# Keycloak (contenedor)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak_db
KC_DB_USERNAME=piedrazul_user
KC_DB_PASSWORD=piedrazul_pass

# Spring Boot (application-dev.yml)
DB_URL=jdbc:postgresql://localhost:5433/piedrazul_dev?currentSchema=public
DB_USERNAME=piedrazul_user
DB_PASSWORD=piedrazul_pass

OAUTH2_ISSUER_URI=http://localhost:8180/realms/piedrazul
KEYCLOAK_SERVER_URL=http://localhost:8180
KEYCLOAK_REALM=piedrazul
KEYCLOAK_CLIENT_ID=piedrazul-backend
